# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon key is safe to expose: it is in the built JavaScript either way.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Who may sign in with Google. Comma-separated addresses.
#
# While sign-in is being built this is the whole gate: set it to your own address and
# nobody else can get a session, whatever they do at the Google prompt. Leave it empty
# and sign-in stays switched off entirely — an empty list admits nobody, never everyone.
#
# It is not a security boundary. It runs in the browser, so it decides what the app
# shows, not what the database gives out. Before any real household data goes into
# Supabase, row level security has to enforce the same rule server-side.
VITE_MEMBER_ALLOWLIST=

# Photographs. All six must be set or uploading and taking down stay switched off, and the
# Photographs screen says so rather than offering a button that fails.
#
# The browser half. The sign URL is this project's own function; the public URL is where the
# bucket serves from (a custom domain on the bucket, so the address survives a change of host).
VITE_PHOTOS_SIGN_URL=/api/photos
VITE_PHOTOS_URL=https://photos.13parbon.org.uk
#
# The server half — Vercel environment variables only, never in this file with values, and
# never in the browser. An R2 API token with Object Read & Write on the one bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
